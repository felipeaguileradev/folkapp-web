# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Feature Flags (true = visible, false = oculto)
# Por defecto todas están habilitadas. En producción, pon false las que quieras ocultar.
NEXT_PUBLIC_FEATURE_DASHBOARD=true
NEXT_PUBLIC_FEATURE_INVENTARIO=true
NEXT_PUBLIC_FEATURE_BAILARINES=true
NEXT_PUBLIC_FEATURE_MOVIMIENTOS=true
NEXT_PUBLIC_FEATURE_CUADROS=true
NEXT_PUBLIC_FEATURE_ALERTAS=true
NEXT_PUBLIC_FEATURE_FUNCIONES=true
NEXT_PUBLIC_FEATURE_REPORTES=true
